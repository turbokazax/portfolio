---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import {
  publication,
  education,
  experience,
  mentoring,
  projects,
  certifications,
  honors,
} from "../data/cv";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Arnur Jumabekov — Researcher" description="Machine learning, computer vision, and robotics. IEEE-published work on medical image analysis and robotic control." active="main">
  <!-- JSON-LD Person schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arnur Jumabekov",
    "url": "https://jubaportfolio.vercel.app/",
    "description": "Undergraduate researcher in machine learning, computer vision, and robotics. Published work on medical image analysis and robotic control.",
    "affiliation": {
      "@type": "CollegeOrUniversity",
      "name": "The Chinese University of Hong Kong"
    },
    "sameAs": [
      "https://linkedin.com/in/arnurjumabekov",
      "https://github.com/turbokazax",
      "https://orcid.org/0009-0006-2199-6865"
    ]
  })} />

  <!-- MAIN / ABOUT -->
  <section class="page-section" id="main">
    <h2 class="content-heading">About Me</h2>
    <p class="lede">
      An undergraduate researcher working on machine learning, computer vision,
      and robotics. I build models that detect disease in chest X-rays and
      control systems that move robots with precision — and I publish what the
      experiments actually show.
    </p>
    <p class="muted body-text">
      The through-line is perception that leads to action: a model that sees
      better, or a robot that moves more accurately. I pursue it through clean
      code, rigorous experiments, and reproducible results.
    </p>

    <div class="seeking">
      <p class="body-text">
        <strong>Currently seeking:</strong> summer 2027 quant and machine-learning
        internships — Hong Kong, Singapore, London, or remote.
      </p>
      <div class="score-chips">
        <a class="chip mono" href="mailto:arnurjumabekov@gmail.com?subject=Research%20internship">Research internships</a>
        <a class="chip mono" href="mailto:arnurjumabekov@gmail.com?subject=Research%20assistant%20position">RA positions</a>
        <a class="chip mono" href="mailto:arnurjumabekov@gmail.com?subject=Collaboration">Collaboration</a>
      </div>
    </div>

    <hr class="hairline" />

    <h2 class="content-heading">Education</h2>
    <ol class="entry-list">
      {education.map((item) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">{item.title}</h3>
            <p class="entry-meta">
              <span class="authors">{item.org}</span>
              <span class="sep">·</span>
              <span class="venue mono">{item.dates}</span>
            </p>
            <p class="entry-desc muted">{item.desc}</p>
            {item.scoreGroups.length > 0 && (
              <ul class="score-group-list">
                {item.scoreGroups.map((group) => (
                  <li class="score-group">
                    <span class="score-group-label">{group.label}</span>
                    <div class="score-chips">
                      {group.scores.map((score) => (
                        <span class="chip mono">{score}</span>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Honors &amp; Awards</h2>
    <ol class="entry-list">
      {honors.map((item) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">{item.title}</h3>
            <p class="entry-meta">
              <span class="venue mono">{item.meta}</span>
            </p>
            <p class="entry-desc muted">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- PUBLICATIONS -->
  <section class="page-section" id="publications">
    <h2 class="content-heading">Publications</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">
            <a href={publication.url}>{publication.title}</a>
          </h3>
          <p class="entry-meta">
            <span class="authors">{publication.authors}</span>
            <span class="sep">·</span>
            <span class="venue mono">{publication.venue}</span>
          </p>
          <p class="entry-desc muted">{publication.desc}</p>
          <details class="bibtex">
            <summary class="mono">BibTeX</summary>
            <pre><code>{publication.bibtex}</code></pre>
          </details>
        </div>
        <div class="entry-links">
          <a href={publication.url} class="chip mono">DOI</a>
        </div>
      </li>
    </ol>
  </section>

  <!-- CV -->
  <section class="page-section" id="cv">
    <h2 class="content-heading">Research &amp; Engineering Experience</h2>
    <ol class="entry-list">
      {experience.map((item) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">{item.title}</h3>
            <p class="entry-meta">
              <span class="authors">{item.org}</span>
              <span class="sep">·</span>
              <span class="venue mono">{item.dates}</span>
            </p>
            <p class="entry-desc muted">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Certifications</h2>
    <ol class="entry-list">
      {certifications.map((item) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">{item.title}</h3>
            <p class="entry-meta">
              <span class="venue mono">{item.meta}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">CV &amp; Portfolio</h2>
    <p class="lede">
      A one-page CV covering research, projects, and technical experience — and
      a slide deck of my robotics &amp; project work.
    </p>
    <div class="cv-downloads">
      <a href="/arnur-jumabekov-cv.pdf" class="download-chip mono">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download CV
      </a>
      <a href="https://docs.google.com/presentation/d/13nTo5pTaWjoK3b-0OeL3S1p8OkDk3izQJ1a37izX4Jc/edit?usp=sharing" class="download-chip download-chip--ghost mono" target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><polyline points="8 21 12 17 16 21"/><line x1="12" y1="12" x2="12" y2="17"/></svg>
        STEM Portfolio
      </a>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="page-section" id="projects">
    <h2 class="content-heading">Projects</h2>
    <ol class="entry-list">
      {projects.map((item) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">{item.title}</h3>
            <p class="entry-meta">
              <span class="venue mono">{item.stack}</span>
              <span class="sep">·</span>
              <span class="mono">{item.dates}</span>
            </p>
            <p class="entry-desc muted">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Mentoring &amp; Teaching</h2>
    <ol class="entry-list">
      {mentoring.map((item) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">{item.title}</h3>
            <p class="entry-meta">
              <span class="authors">{item.org}</span>
              <span class="sep">·</span>
              <span class="venue mono">{item.dates}</span>
            </p>
            <p class="entry-desc muted">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- BLOG -->
  <section class="page-section" id="blog">
    <h2 class="content-heading">Blog</h2>
    <p class="lede">
      Notes on research, papers, and building things. Shorter and more
      frequent than publications.
    </p>
    {posts.length === 0 ? (
      <p class="muted body-text">No posts published yet.</p>
    ) : (
      <ol class="entry-list">
        {posts.map((post) => (
          <li class="entry">
            <div class="entry-main">
              <h3 class="entry-title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="entry-meta">
                <time class="mono" datetime={post.data.date.toISOString().slice(0, 10)}>
                  {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
                </time>
              </p>
              <p class="entry-desc muted">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="prose-tags">
                  {post.data.tags.map((tag) => (
                    <li class="chip mono">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    )}
  </section>
</Layout>

<style>
  .seeking {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bibtex {
    margin-top: var(--space-3);
  }

  .bibtex summary {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    cursor: pointer;
  }

  .bibtex pre {
    margin: var(--space-2) 0 0;
    padding: var(--space-3);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--ink-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
  }
</style>
