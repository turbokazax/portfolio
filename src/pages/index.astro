---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Arnur Jumabekov — Researcher" description="Aspiring researcher — computer vision & robotics. Published work on medical image analysis and robotic control." active="main">
  <!-- MAIN / ABOUT -->
  <section class="page-section" id="main">
    <h2 class="content-heading">About Me</h2>
    <p class="lede">
      A top-grade STEM student and published researcher working at the
      intersection of computer vision and robotics. My current focus is on
      medical image analysis — building models that detect disease in chest
      X-rays — and on the control systems that let robots move with precision.
    </p>
    <p class="muted body-text">
      I pursue this through rigorous experiments, clean code, and papers that
      report what actually happened. The through-line is perception that leads
      to action: a model that sees better, or a robot that moves more accurately.
    </p>

    <hr class="hairline" />

    <h2 class="content-heading">Education</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">High School Diploma (A-Levels)</h3>
          <p class="entry-meta">
            <span class="authors">Haileybury Almaty</span>
            <span class="sep">·</span>
            <span class="venue mono">Aug 2023 – Jun 2025</span>
          </p>
          <p class="entry-desc muted">
            A-Levels: Computer Science (A*), Maths (A*), Further Maths (A*), Physics (A).
            IELTS 8.0 · SAT 1550 (750 EBRW, 800 Math) · AP Calculus BC 5, AP CS A 5.
          </p>
        </div>
      </li>
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Activities</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Role — Organization</h3>
          <p class="entry-meta">
            <span class="authors">Organization</span>
            <span class="sep">·</span>
            <span class="venue mono">Year – Year</span>
          </p>
          <p class="entry-desc muted">
            Description of responsibility and what came of it.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- PUBLICATIONS -->
  <section class="page-section" id="publications">
    <h2 class="content-heading">Publications</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">
            <a href="https://ieeexplore.ieee.org/document/10898141">WeCAViT: A Weighted CNN model for Pneumonia Detection in Chest X-rays</a>
          </h3>
          <p class="entry-meta">
            <span class="authors">Arnur Jumabekov, Maryam Yashtini</span>
            <span class="sep">·</span>
            <span class="venue mono">13th IEEE ICCIP, March 2025</span>
          </p>
          <p class="entry-desc muted">
            Hybrid CNN-CBAM-ViT architecture for pneumonia detection in chest X-rays.
          </p>
        </div>
        <div class="entry-links">
          <a href="https://ieeexplore.ieee.org/document/10898141" class="chip mono">DOI</a>
        </div>
      </li>
    </ol>
  </section>

  <!-- PROJECTS -->
  <section class="page-section" id="projects">
    <h2 class="content-heading">Projects</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">WeCAViT</h3>
          <p class="entry-meta">
            <span class="venue mono">Python, PyTorch, Pandas, Scikit-Learn, Google Colab, Huggingface Transformers</span>
            <span class="sep">·</span>
            <span class="mono">Jun 2024 – Present</span>
          </p>
          <p class="entry-desc muted">
            Hybrid CNN-CBAM-ViT model for pneumonia detection; ~4-5% accuracy &amp; F1 increase over SOTA CNNs/ViTs/hybrids.
            &gt;17 ablation experiments, &gt;8 SOTA comparisons; authored research paper.
          </p>
        </div>
      </li>
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">QuantaSoil</h3>
          <p class="entry-meta">
            <span class="venue mono">Python, Pandas, Scikit-Learn, Google Colab, OpenAI API</span>
            <span class="sep">·</span>
            <span class="mono">Sep 2023 – Nov 2023</span>
          </p>
          <p class="entry-desc muted">
            ML classifiers to predict optimal crop/fertilizer from soil data; &gt;95% accuracy.
            Custom GPT-4 text prompts via OpenAI API; integrated in React web app.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- CV -->
  <section class="page-section" id="cv">
    <h2 class="content-heading">Curriculum Vitae</h2>
    <p class="lede">
      You can download my full CV below, or browse the highlights throughout
      this site.
    </p>
    <div class="entry-links" style="margin-top: var(--space-4);">
      <a href="#" class="chip mono">Download CV (PDF)</a>
    </div>

    <hr class="hairline" />

    <h2 class="content-heading">Research Experience</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Smart Pipe Inspection Robot — Research Assistant</h3>
          <p class="entry-meta">
            <span class="authors">ARMS Lab, Nazarbayev University, Astana</span>
            <span class="sep">·</span>
            <span class="venue mono">Aug 2025 – Present</span>
          </p>
          <p class="entry-desc muted">
            Developing Python API to control Dynamixel DC motors; custom path-following algorithms.
          </p>
        </div>
      </li>
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Tensegrity Robot Project — Intern, Lead Programmer</h3>
          <p class="entry-meta">
            <span class="authors">ISSAI, Nazarbayev University, Astana</span>
            <span class="sep">·</span>
            <span class="venue mono">May 2024 – Jun 2024</span>
          </p>
          <p class="entry-desc muted">
            C++ control firmware for Arduino; modular OOP architecture; PID control for linear actuators, &lt;5% position error.
            Python pipelines for real-time position extraction via Serial Port for OptiTrack feedback.
          </p>
        </div>
      </li>
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Pioneer Research Institute — Student Researcher</h3>
          <p class="entry-meta">
            <span class="authors">Supervised by Dr. Maryam Yashtini (Georgetown), Remote</span>
            <span class="sep">·</span>
            <span class="venue mono">Jun 2024 – Jan 2025</span>
          </p>
          <p class="entry-desc muted">
            Literature review on CV in Healthcare; proposed and experimented on WeCAViT architecture.
          </p>
        </div>
      </li>
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Certifications</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Samsung Innovation Campus — Android Development Track</h3>
          <p class="entry-meta">
            <span class="venue mono">Java, Google Firebase SDK · 2020–2021</span>
          </p>
        </div>
      </li>
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Microsoft AI Challenge — Machine Learning Track</h3>
          <p class="entry-meta">
            <span class="venue mono">Python, PyTorch, scikit-learn, pandas, NumPy, matplotlib · 2023</span>
          </p>
        </div>
      </li>
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Teaching</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Teaching Assistant — Course Name</h3>
          <p class="entry-meta">
            <span class="authors">University Name</span>
            <span class="sep">·</span>
            <span class="venue mono">Term Year</span>
          </p>
          <p class="entry-desc muted">
            Brief description of role and responsibilities.
          </p>
        </div>
      </li>
    </ol>

    <hr class="hairline" />

    <h2 class="content-heading">Honors &amp; Awards</h2>
    <ol class="entry-list">
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">ISEF Special Award</h3>
          <p class="entry-meta">
            <span class="venue mono">Regeneron &amp; "Mawhiba" Foundation · 2025</span>
          </p>
        </div>
      </li>
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">Kazakhstan Republican Science Projects Fair (KazSEF) — Gold Medal</h3>
          <p class="entry-meta">
            <span class="venue mono">Top 0.7%, "Informatics" · 2025</span>
          </p>
        </div>
      </li>
      <li class="entry">
        <div class="entry-main">
          <h3 class="entry-title">British Physics Olympiad — Silver Medal</h3>
          <p class="entry-meta">
            <span class="venue mono">Top ~10% worldwide · 2024</span>
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- BLOG -->
  <section class="page-section" id="blog">
    <h2 class="content-heading">Blog</h2>
    <p class="lede">
      Notes on research, papers, and building things. Shorter and more
      frequent than publications.
    </p>
    <ol class="entry-list">
      {posts.map((post) => (
        <li class="entry">
          <div class="entry-main">
            <h3 class="entry-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p class="entry-meta">
              <time class="mono" datetime={post.data.date.toISOString().slice(0, 10)}>
                {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </p>
            <p class="entry-desc muted">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="prose-tags">
                {post.data.tags.map((tag) => (
                  <li class="chip mono">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ALBUMS -->
  <section class="page-section" id="albums">
    <h2 class="content-heading">Albums</h2>
    <p class="lede">
      Photos from conferences, labs, and the field. A visual log of the work.
    </p>
    <ol class="album-list">
      <li class="album">
        <div class="album-grid">
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
        </div>
        <p class="album-meta"><span class="album-name">Conference 2026</span> <span class="mono album-count">12 photos</span></p>
      </li>
      <li class="album">
        <div class="album-grid">
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
        </div>
        <p class="album-meta"><span class="album-name">Lab &amp; Builds</span> <span class="mono album-count">8 photos</span></p>
      </li>
      <li class="album">
        <div class="album-grid">
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
          <div class="album-tile"></div>
        </div>
        <p class="album-meta"><span class="album-name">Field &amp; Travel</span> <span class="mono album-count">15 photos</span></p>
      </li>
    </ol>
  </section>
</Layout>
