---
import Topbar from "../components/Topbar.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = "Researcher",
  description = "Undergrad researcher exploring computer vision and robotics.",
  active = "main",
} = Astro.props;

const navLinks = [
  { label: "Publications", id: "publications" },
  { label: "Projects", id: "projects" },
  { label: "CV", id: "cv" },
  { label: "Blog", id: "blog" },
  { label: "Albums", id: "albums" },
];
---
<!--
  DIRECTION CONTRACT — seed key: 1ab788c1
  LAYOUT: Global top navbar (name + section links + dark toggle) spanning full
  width. Below: two columns. Left = identity (avatar, name, tagline, location,
  bio, social icons, footer). Right = ONE section at a time selected from navbar.
  Matches AcademicPages / yeraly.dsml.kz reference.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
  finish review, the verdict, and DESIGN.md
-->
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jubaportfolio.vercel.app/" />
    <meta property="og:image" content="https://jubaportfolio.vercel.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Arnur Jumabekov — Researcher" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://jubaportfolio.vercel.app/og-image.png" />
    <!-- Misc SEO -->
    <meta name="theme-color" content="#3b37c9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="app">
      <!-- GLOBAL TOP NAVBAR -->
      <Topbar active={active} links={navLinks} />

      <!-- MAIN TWO-COLUMN AREA -->
      <div class="shell">
      <!-- LEFT: Identity -->
      <aside class="sidebar">
        <div class="sidebar-masthead">
          <div class="avatar-ring">
            <img
              class="avatar"
              src="/profile.jpg"
              alt="Profile photo"
              width="140"
              height="140"
            />
          </div>
          <h1 class="sidebar-name">Arnur Jumabekov</h1>
          <p class="sidebar-tagline">
            Aspiring researcher — computer vision &amp; robotics
          </p>
          <p class="sidebar-location mono">Almaty, Kazakhstan</p>
          <a class="sidebar-email" href="mailto:arnurjumabekov@gmail.com">
            <svg class="sidebar-email-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>arnurjumabekov@gmail.com</span>
          </a>
        </div>

        <p class="sidebar-bio">
          Top-grade STEM student (A* A-levels, SAT 1550, IELTS 8.0) and
          published researcher across computer vision and robotics.
        </p>

        <div class="sidebar-footer">
          <nav class="social-row" aria-label="Social links">
            <a href="https://linkedin.com/in/arnur-jumabekov" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://github.com/turbokazax" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
            </a>
            <a href="https://t.me/arnijuba" aria-label="Telegram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </a>
            <a href="https://orcid.org/0009-0006-2199-6865" aria-label="ORCID">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-1.847-1.238-3.722-3.916-3.722h-2.403z"/></svg>
            </a>
          </nav>
          <a class="footer-sitemap" href="/sitemap-index.xml" aria-label="Sitemap">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            Sitemap
          </a>
          <p class="sidebar-copyright mono">© 2026 Arnur Jumabekov<br />All rights reserved.</p>
        </div>
      </aside>

        <!-- RIGHT: Content (one section at a time) -->
        <main class="content" id="main-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      // Tab navigation: show one section at a time
      function showSection(id) {
        document.querySelectorAll(".page-section").forEach(function (sec) {
          if (sec.id === id) {
            sec.style.display = "block";
            sec.classList.remove("is-visible");
            void sec.offsetWidth; // reflow to restart animation
            sec.classList.add("is-visible");
          } else {
            sec.style.display = "none";
            sec.classList.remove("is-visible");
          }
        });
        document.querySelectorAll(".topbar-link").forEach(function (link) {
          link.classList.toggle("active", link.dataset.nav === id);
        });
      }

      // Handle nav clicks
      document.querySelectorAll(".topbar-link").forEach(function (link) {
        link.addEventListener("click", function (e) {
          e.preventDefault();
          const id = link.dataset.nav;
          showSection(id);
          if (history.replaceState) history.replaceState(null, "", "#" + id);
        });
      });

      // Show initial section from URL hash or default to "main"
      (function () {
        const hash = window.location.hash.replace("#", "");
        showSection(hash || "main");
      })();

      // Respond to hash changes (name link, browser back/forward)
      window.addEventListener("hashchange", function () {
        const hash = window.location.hash.replace("#", "");
        showSection(hash || "main");
      });
    </script>
  </body>
</html>
