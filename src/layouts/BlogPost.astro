---
import BaseHead from "../components/BaseHead.astro";
import Topbar from "../components/Topbar.astro";
import { navLinks } from "../nav";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  date?: string;
}

const {
  title = "Researcher",
  description = "",
  date,
} = Astro.props;

const ogImage = new URL("/og-image.png", Astro.site ?? Astro.url.origin).href;
const pageUrl = Astro.url.href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  author: {
    "@type": "Person",
    name: "Arnur Jumabekov",
    url: "https://jubaportfolio.vercel.app/",
  },
  publisher: {
    "@type": "Person",
    name: "Arnur Jumabekov",
  },
  ...(date && { datePublished: date }),
  image: ogImage,
  mainEntityOfPage: pageUrl,
};
---

<!--
  DIRECTION CONTRACT — seed key: 1ab788c1
  SURFACE: Blog post reading view. Global topbar (shared Topbar component)
  + a single centered reading column (~68ch). Inherits Research Atelier world.
  Topbar anchors point back at the homepage sections. Mode: Read.
-->
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={title} description={description} ogType="article" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="blog-post-view">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Topbar links={navLinks} active="blog" />

    <main class="blog-post" id="main-content">
      <article class="prose">
        <slot />
      </article>
      <footer class="blog-post-footer">
        <a href="/" class="back-link">&larr; Back to home</a>
      </footer>
    </main>
  </body>
</html>
